# Copy to .env.local and fill in with real values. Never commit .env.local.

# Public — safe to expose to the browser (Supabase project URL + publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The author's own profile id (auth.users.id / profiles.id) — the only
# account allowed to call POST /api/admin/notifications. Public because
# it's just an id, not a secret; the route itself is what's protected.
NEXT_PUBLIC_ADMIN_USER_ID=

# Server-only — database connection string. Must never be referenced from
# client-bundled code (enforced by the `server-only` import in src/lib/db).
DATABASE_URL=

# Server-only — Supabase service-role key (Project Settings → API →
# service_role key). Not currently used by any route (profiles.email,
# added for the password-auth refactor, covers the one lookup that would
# otherwise have needed it), but documented here in case an admin-level
# call is added later.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — Resend API key (resend.com → API Keys). Used by
# src/lib/email/send-auth-email.ts to send every auth email (signup
# confirmation, magic link, password reset, email change) via the
# Supabase "Send Email" auth hook.
RESEND_API_KEY=

# Server-only — signing secret for Supabase's "Send Email" auth hook
# (Supabase Dashboard → Authentication → Hooks → Send Email Hook →
# enable, point it at POST /api/auth/send-email, copy the generated
# secret here). Format: `v1,whsec_<base64>`. Verified in
# src/app/api/auth/send-email/route.ts — if this is unset or doesn't
# match what's configured in the Supabase dashboard, the hook 401s and
# Supabase's own auth.signUp()/resend() calls fail as a result, since
# the hook runs synchronously inside them.
SUPABASE_HOOK_SECRET=
